# Backend API (Fastify on Render in prod, localhost:3000 in dev)
NEXT_PUBLIC_API_URL=http://localhost:3000

# Supabase — public values (anon key is safe to expose)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Stripe — public publishable key only (NEVER put secret key here)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# Web Push (VAPID public key — server holds the private)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Sentry (optional)
NEXT_PUBLIC_SENTRY_DSN=

# Public origin used for sitemap.xml + canonical URLs + JSON-LD identifiers
NEXT_PUBLIC_SITE_URL=https://mindscrolling.com
