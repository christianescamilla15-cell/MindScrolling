# =============================================================================
# MindScrolling — .gitignore
# Covers: Node.js · Flutter · Android · iOS · Supabase · VS Code · Windows
# =============================================================================

# ─── Secrets & Environment ───────────────────────────────────────────────────
.env
.env.local
.env.*.local
.env.development
.env.production
.env.test
*.secret
secrets/

# Keep examples tracked
!.env.example
!backend/.env.example
!flutter_app/.env.example

# ─── Node.js / Backend ───────────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-debug.log*
yarn.lock
.pnp.*
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz

# Runtime
*.pid
*.seed
*.pid.lock
pids/
logs/
*.log

# Build & coverage
dist/
build/Release
coverage/
*.lcov
.nyc_output
lib-cov

# Cache
.npm
.eslintcache
.stylelintcache
.rpt2_cache/
.rts2_cache_cjs/
.rts2_cache_es/
.rts2_cache_umd/
.cache
.parcel-cache
.node_repl_history
*.tsbuildinfo

# ─── Flutter / Dart ───────────────────────────────────────────────────────────
flutter_app/.dart_tool/
flutter_app/.flutter-plugins
flutter_app/.flutter-plugins-dependencies
flutter_app/.packages
flutter_app/pubspec.lock
flutter_app/build/
flutter_app/.fvm/

# Generated Dart files
*.g.dart
*.freezed.dart
*.mocks.dart

# ─── Android ─────────────────────────────────────────────────────────────────
flutter_app/android/.gradle/
flutter_app/android/captures/
flutter_app/android/gradlew
flutter_app/android/gradlew.bat
flutter_app/android/local.properties
flutter_app/android/key.properties
flutter_app/android/**/*.keystore
flutter_app/android/**/*.jks
flutter_app/android/app/debug/
flutter_app/android/app/release/
flutter_app/android/app/profile/
flutter_app/android/app/google-services.json

# ─── iOS ─────────────────────────────────────────────────────────────────────
flutter_app/ios/Pods/
flutter_app/ios/.symlinks/
flutter_app/ios/Flutter/Flutter.framework
flutter_app/ios/Flutter/Flutter.podspec
flutter_app/ios/Flutter/App.framework
flutter_app/ios/Flutter/ephemeral/
flutter_app/ios/Runner.xcworkspace/xcuserdata/
flutter_app/ios/Runner.xcodeproj/xcuserdata/
flutter_app/ios/GoogleService-Info.plist
*.xcuserstate

# ─── Vite / Frontend (legacy) ────────────────────────────────────────────────
frontend/node_modules/
frontend/dist/
frontend/.vite/

# ─── Supabase ────────────────────────────────────────────────────────────────
.supabase/
supabase/.branches/
supabase/.temp/

# ─── VS Code ─────────────────────────────────────────────────────────────────
.vscode/settings.json
.vscode/launch.json
.vscode/tasks.json
.vscode/*.code-snippets
.history/
*.vsix

# Keep shared VS Code extensions recommendation
!.vscode/extensions.json

# ─── OS & temp files ─────────────────────────────────────────────────────────
# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Linux
*~

# ─── Editors ─────────────────────────────────────────────────────────────────
*.swp
*.swo
*.swn
*.bak
*.orig
*.tmp

# JetBrains / Android Studio
.idea/
*.iml
*.ipr
*.iws
.idea/workspace.xml
.idea/tasks.xml
.idea/gradle.xml
.idea/assetWizardSettings.xml
.idea/dictionaries/
.idea/libraries/
.idea/caches/

# ─── Sprint & QA workflow ─────────────────────────────────────────────────────
.sprint-state.json
.sprint-prompts/
.sprint-reports/
.qa-reports/

# ─── Tags / misc generated ───────────────────────────────────────────────────
tags_temp.json
*.tags
Key

# ─── AI tooling cache & ephemeral state ──────────────────────────────────────
# Outputs from local AI assistants — Claude Code, Kiro, NexusForge AIOS, etc.
# These regenerate per-session and shouldn't be tracked.
.aios/cache/
.claude/agents/
.claude/memory/
.kiro/
ai-memory/.aios_interactions.json
ai-memory/active_workstream.md
ai-memory/recent_decisions.md
ai-memory/task_history.md

# ─── Lighthouse audit output ─────────────────────────────────────────────────
# Generated by `npx lighthouse` runs. Not meant to be committed.
.lighthouse/

# ─── IDE local state (per-machine, never shared) ─────────────────────────────
.vscode/extensions.json

# ─── Vercel local link state ─────────────────────────────────────────────────
# Generated by `vercel link` / `vercel dev`. Per-machine.
.vercel/

# ─────────────────────────────────────────────────────────────
# NexusForge Security Policy - Never commit these
# ─────────────────────────────────────────────────────────────

# Environment variables
.env
.env.*
!.env.example
!.env.template
!.env.sample

# Credentials & Keys
*.key
*.pem
*.p12
*.pfx
*.crt
*.cert
credentials.json
service-account*.json
firebase-adminsdk-*.json
google-services.json
GoogleService-Info.plist
client_secret*.json
auth.json
token.json
.aws/
.ssh/

# Secrets directories
secrets/
.secrets/
private/
.private/

# IDE & OS
.DS_Store
Thumbs.db
.idea/
.vscode/settings.json
*.swp
*.swo

# Build & dependencies
node_modules/
dist/
build/
out/
target/
*.log
.cache/
.parcel-cache/

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.venv/
venv/
env/
.pytest_cache/

# Deployment
.vercel/
.netlify/
.firebase/
.serverless/

# ─── AIOS / Mythos / Nemesis runtime artifacts ───────────────────────────────
# Track: findings, reports, config. Ignore: caches, scratch workspaces.
.aios/cache/
arena/arena-memory/runs/*/workspace/
nemesis/nemesis-engagements/*/workspace/
nemesis-engagements/*/workspace/
mythos-output/tmp/
